{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "resolveJsonModule": true,
    "rootDir": "career", "outDir": "src/moneybread", "declaration": true,
    "noEmitOnError": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["career/**/*.ts", "career/**/*.json"]
}
